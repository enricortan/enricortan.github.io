# Copy to .env (gitignored). Never commit .env. Both values also live in the GitHub repository
# secrets of the same names, and in your password manager.
#
# Page password for protected case studies, lab items and notes: what visitors type to unlock them.
# Used only at build time (AES-256-GCM, PBKDF2-SHA256 600k). Without it, protected pages build as
# "locked — unavailable" (CI refuses to deploy that). Use a long passphrase (4+ random words),
# never reused from anywhere else.
PROTECTED_PASSWORD=

# Key that seals src/content-private/ (the FLNT source) into sealed/content-private.sealed.
# 32 random bytes, base64. Create it once with `npm run keygen` (it never prints the key).
# On a new machine, paste it here from your password manager, then `npm run unseal`.
CONTENT_KEY=
