---
/** The ER mark as inline SVG, two flat fills from CSS (--mark-outer / --mark-inner). Internal helper. */
import { MARK_INNER, MARK_OUTER, MARK_VIEWBOX } from '../../assets/brand/mark';

interface Props {
  class?: string;
  /** Accessible name; omit for a decorative mark (aria-hidden). */
  label?: string;
}
const { class: cls, label } = Astro.props;
---

<svg
  class={cls}
  viewBox={MARK_VIEWBOX}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
><path class="mo" d={MARK_OUTER}></path><path class="mi" d={MARK_INNER}></path></svg>
