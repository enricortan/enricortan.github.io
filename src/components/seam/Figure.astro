---
/**
 * Figure (Kai): one still. AVIF + WebP with a JPEG fallback, square corners, no device mockups.
 * ratio crops to 16:10 or 4:5 (object-fit, top-anchored, as UI reads from the top); auto keeps
 * the image's own ratio. priority = the LCP image: eager + fetchpriority high.
 * In a case body it spans columns 2–11 (data-bleed="wide").
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  ratio?: '16:10' | '4:5' | 'auto';
  priority?: boolean;
}
const { src, alt, caption, ratio = 'auto', priority = false } = Astro.props;

const STEPS = [640, 960, 1280, 1920, 2560];
const widths = STEPS.filter((w) => w < src.width).concat(src.width);
const sizes =
  ratio === '4:5'
    ? '(min-width: 900px) 50vw, 100vw'
    : '(min-width: 1440px) 1328px, (min-width: 900px) calc(100vw - 8vw), 100vw';
---

<figure class="figure" data-ratio={ratio} data-bleed="wide">
  <div class="figure-frame">
    <Picture
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={widths}
      sizes={sizes}
      loading={priority ? 'eager' : 'lazy'}
      decoding={priority ? 'sync' : 'async'}
      fetchpriority={priority ? 'high' : undefined}
    />
  </div>
  {caption && <figcaption class="mono">{caption}</figcaption>}
</figure>
